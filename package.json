{
  "name": "homeney-workspace",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "start": "./start.sh",
    "dev:backend": "./mvnw spring-boot:run",
    "dev:frontend": "cd frontend && npm run dev",
