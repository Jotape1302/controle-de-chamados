# Copie para .env e ajuste. NUNCA versione o arquivo .env.

# Banco de dados
POSTGRES_DB=homeney
POSTGRES_USER=homeney
POSTGRES_PASSWORD=troque-esta-senha

# Segredo de assinatura do JWT (min. 32 caracteres). Gere com: openssl rand -base64 48
JWT_SECRET=

# Administrador criado na primeira subida (apenas se o banco nao tiver usuarios)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Porta onde a aplicacao ficara acessivel (http://localhost:3000)
WEB_PORT=3000

# Expor Swagger em producao? (true/false)
SWAGGER_ENABLED=false
